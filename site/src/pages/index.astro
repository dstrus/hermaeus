---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import Screen from '../components/Screen.astro';
import Diamond from '../components/Diamond.astro';
import { downloads, repository, releases, issues, license } from '../links';

import memoriesDark from '../assets/screens/memories-dark.png';
import memoriesLight from '../assets/screens/memories-light.png';
import diaryDark from '../assets/screens/diary-dark.png';
import diaryLight from '../assets/screens/diary-light.png';
import charactersDark from '../assets/screens/characters-dark.png';
import charactersLight from '../assets/screens/characters-light.png';
import historyDark from '../assets/screens/history-dark.png';
import historyLight from '../assets/screens/history-light.png';

// Screens of the app running on a made-up playthrough, in story order.
const screens = [
	{
		title: 'Memories',
		text: 'Every memory an NPC holds: what happened, when in the game’s calendar, and how much it mattered to them. Change one, move it to a different NPC, or send it to Oblivion.',
		dark: memoriesDark,
		light: memoriesLight,
		alt: 'Hermaeus showing Hjordis Ashen-Hand’s memories in a table, one selected, with its details beside it.'
	},
	{
		title: 'Diaries',
		text: 'Each NPC’s diary entries. Rewrite an entry, add a new one, or remove one entirely.',
		dark: diaryDark,
		light: diaryLight,
		alt: 'Hermaeus showing Hjordis Ashen-Hand’s diary, with an entry about the barrow selected.'
	},
	{
		title: 'Characters',
		text: 'Everyone you’ve met in a playthrough, with their stats, their bios, and pins for your favorites.',
		dark: charactersDark,
		light: charactersLight,
		alt: 'Hermaeus listing the characters in a playthrough, with Hjordis Ashen-Hand selected.'
	},
	{
		title: 'History',
		text: 'What SkyrimNet recorded happening, dated the way the game dates it (Tirdas, 4th of Hearthfire, and so on).',
		dark: historyDark,
		light: historyLight,
		alt: 'Hermaeus listing a playthrough’s events by in-game day.'
	}
];

// The rest of what Hermaeus opens, grouped as its own sections column is.
const rest = [
	{
		group: 'Playthrough',
		pages: [
			['Bios', 'Edit an NPC’s bio for this playthrough, or restore an earlier version.'],
			['Knowledge', 'Add what NPCs know, and edit knowledge packs.'],
			['Screenshots', 'Read and correct what OmniSight saw in each screenshot.'],
			['Bard songs', 'Read the words, play the song, and fix or remove it.']
		]
	},
	{
		group: 'Behavior and memory',
		pages: [
			['Prompts', 'Edit SkyrimNet’s prompts as your own copies, with their markup checked before you save.'],
			['Settings', 'Each settings file compared with SkyrimNet’s defaults, with <span class="changed">what you changed</span> highlighted, and changed in place.'],
			['Quick toggles', 'The switches you flip most, in one place.']
		]
	},
	{
		group: 'AI and library',
		pages: [
			['Models', 'Choose the model for each task from your provider’s list.'],
			['Providers', 'Set API keys. Once it’s set, it never reaches the browser again.'],
			['Plugins', 'Turn SkyrimNet’s plugins on and off, and change their order.'],
			['Content', 'SkyrimNet’s content records, edited in forms rather than raw YAML.']
		]
	}
];

// Loading-screen tips for the hint strip, as Skyrim shows while you wait:
// each one true, one picked at random per visit, the next on a click.
const tips = [
	'You can look around while Skyrim is running. You just can’t save until you close it.',
	'Your first change to a database each session gets a backup first, in hermaeus-backups.',
	'MO2 users: put Hermaeus.exe next to ModOrganizer.exe and it finds SkyrimNet on its own.',
	'Every save is one transaction. Either all of it works, or nothing changes.',
	'Hermaeus only listens on 127.0.0.1. The rest of the internet doesn’t get a say.',
	'Your API keys never reach the browser. Hermaeus only tells it whether one is set.',
	'Hermaeus dates things the way the game does. Tirdas is Tuesday. You’re welcome.',
	'Hermaeus Mora hoards knowledge and memories. This one just lets you edit them.',
	'Everything on this page works from the keyboard. Try N.'
];

const safety = [
	{
		rule: 'Hands off while Skyrim runs',
		text: 'SkyrimNet keeps its database open while the game is running, so Hermaeus says <span class="running caps">Skyrim running · read-only</span> and refuses to save until you close it. You can still look around.'
	},
	{
		rule: 'A backup before the first change',
		text: 'Before the first change to each database in a session, a copy goes to hermaeus-backups in the SkyrimNet folder.'
	},
	{
		rule: 'All or nothing',
		text: 'Every save happens in one transaction. If any part of it fails, nothing changes.'
	},
	{
		rule: 'Only what you changed',
		text: 'Files SkyrimNet reads are rewritten with the smallest change that does the job, in SkyrimNet’s own format, with their line endings kept.'
	},
	{
		rule: 'Your machine only',
		text: 'Hermaeus listens only on 127.0.0.1, and every request has to carry a token from its own page, so other websites open in your browser can’t reach your data.'
	}
];
---

<Base
	title="Hermaeus: read and edit what SkyrimNet remembers, with Skyrim closed"
	description="An unofficial, offline dashboard for SkyrimNet. Read and edit memories, diaries, bios, prompts, and settings from your own installation while Skyrim is closed."
>
	<a class="skip caps" href="#main">Skip to content</a>

	<header class="top">
		<a class="brand caps" href="#top" aria-label="Hermaeus, to the top"><Mark size="1.35em" /> Hermaeus</a>
		<nav class="sections caps" aria-label="On this page">
			<a href="#why">Why</a>
			<a href="#screens">What it does</a>
			<a href="#safety">Safety</a>
			<a href="#download">Download</a>
		</nav>
		<div class="theme caps" role="group" aria-label="Theme">
			<button type="button" data-theme-choice="system" aria-pressed="true">Auto</button>
			<button type="button" data-theme-choice="dark" aria-pressed="false">Dark</button>
			<button type="button" data-theme-choice="light" aria-pressed="false">Light</button>
		</div>
	</header>

	<main id="main">
		<section class="hero" id="top" aria-labelledby="name">
			<div class="offer">
				<h1 id="name" class="caps">Hermaeus</h1>
				<p class="hook">Read and edit what SkyrimNet remembers, <strong>with Skyrim closed</strong>.</p>
				<p class="sub">Memories, diaries, bios, prompts, and settings, straight from your own installation. No game to launch, no headset to strap on.</p>
				<div class="downloads" data-downloads>
					{
						downloads.map((d, i) => (
							<a class:list={['button', { primary: i === 0 }]} href={d.href} data-os={d.os}>
								<span>
									<Diamond />
									<span class="for">Download for </span>
									{d.label}
								</span>
								{d.note && <small>{d.note}</small>}
							</a>
						))
					}
				</div>
				<p class="fine"><strong>Unofficial.</strong> Works with SkyrimNet, isn’t part of it, and isn’t affiliated with or endorsed by Fateless.Ai.</p>
			</div>

			<figure class="entry" aria-label="A diary entry, as SkyrimNet stores it">
				<figcaption class="dateline caps">
					<span class="author">Hjordis Ashen-Hand</span>
					<span class="when">Tirdas, 4th of Hearthfire, 4E 201 <span aria-hidden="true">·</span> Falkreath <span aria-hidden="true">·</span> Uneasy</span>
				</figcaption>
				<blockquote>
					<p>
						The stranger paid for three nights and slept for one. Asked about the barrow on the ridge, then asked again as if I hadn’t answered. I told
						them what I tell everyone: the dead keep to themselves if you keep to yourself. They left before the fog lifted. I’ve moved the good knives
						back under the bar.
					</p>
				</blockquote>
				<div class="locus">
					<dl>
					<div>
						<dt class="caps">Kept in</dt>
						<dd>the playthrough’s database</dd>
					</div>
					<div>
						<dt class="caps">Importance</dt>
						<dd>7</dd>
					</div>
					<div>
						<dt class="caps">Diary entry</dt>
						<dd>9 of 12</dd>
					</div>
					</dl>
				</div>
				<p class="synthetic caps">(From a fake playthrough)</p>
			</figure>

			<a class="more caps" href="#why">
				Why does this exist?
				<svg width="14" height="16" viewBox="0 0 14 16" aria-hidden="true"><path d="M7 1v13M1 8l6 6 6-6" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg>
			</a>
		</section>

		<section class="block why" id="why" aria-labelledby="why-title">
			<div class="intro">
				<h2 id="why-title" class="caps">Because I wanted it</h2>
				<p>
					SkyrimNet’s own dashboard is excellent, but it only works while the game is running. I play Skyrim VR with <a href="https://synergyvr.org/mgo">around 1,700 mods</a>,
					so launching the game and loading a save takes several minutes, and I have to wear my headset the whole time.
				</p>
				<p>
					Everything I usually want to change is sitting in simple files. Finding the right file (and the right <em>copy</em> of that
					file) isn’t always straightforward, so I built something that knows where to look.
				</p>
			</div>
			<div class="asides">
				<aside class="btw" aria-labelledby="btw-dashboard">
					<p id="btw-dashboard" class="btw-title caps">By the way…</p>
					<p>
						You should probably use SkyrimNet’s dashboard unless you have a good reason not to. Hermaeus isn’t a 1:1 replacement. Plenty of things
						really do need the game running, so it sticks to what I (and maybe you) most want to change offline.
					</p>
				</aside>
				<aside class="btw" aria-labelledby="btw-name">
					<p id="btw-name" class="btw-title caps">Why “Hermaeus”?</p>
					<p>
						Hermaeus Mora is the Daedric Prince of knowledge, memory, etc. SkyrimNet hoards knowledge and memories too!
					</p>
				</aside>
			</div>
		</section>

		<section class="block" id="screens" aria-labelledby="screens-title">
			<div class="intro">
				<h2 id="screens-title" class="caps">Browse and edit all the things.</h2>
				<p>
					Everything SkyrimNet remembers about a playthrough is in files on your machine, nearly all of it in files that are easy to edit. Hermaeus opens them in your browser
					and saves your changes back where SkyrimNet will find them.
				</p>
			</div>
			<ol class="shots" data-shots>
				{
					screens.map((s, i) => (
						<li class="shot">
							<div class="caption">
								<h3 class="caps">
									<Diamond />
									{s.title}
								</h3>
								<p>{s.text}</p>
							</div>
							<Screen dark={s.dark} light={s.light} alt={s.alt} eager={i === 0} />
						</li>
					))
				}
			</ol>
			<p class="synthetic caps">Data from a fake playthrough</p>
		</section>

		<section class="block" id="rest" aria-labelledby="rest-title">
			<div class="intro">
				<h2 id="rest-title" class="caps">And the rest of SkyrimNet</h2>
				<p>Not everything, mind you. Some things really do need the game running. This is the stuff I (and maybe you) most want to change without launching Skyrim.</p>
			</div>
			<table class="items">
				<caption class="visually-hidden">What else Hermaeus opens</caption>
				<thead>
					<tr>
						<th scope="col" class="caps">Page</th>
						<th scope="col" class="caps">What you can do there</th>
					</tr>
				</thead>
				{
					rest.map((g) => (
						<tbody>
							<tr class="group">
								<th scope="colgroup" colspan="2" class="caps">
									{g.group}
								</th>
							</tr>
							{g.pages.map(([name, text]) => (
								<tr>
									<th scope="row" class="caps">
										{name}
									</th>
									<td set:html={text} />
								</tr>
							))}
						</tbody>
					))
				}
			</table>
		</section>

		<section class="block" id="safety" aria-labelledby="safety-title">
			<div class="intro">
				<h2 id="safety-title" class="caps">Before you point it at your saves</h2>
				<p>Hermaeus edits files SkyrimNet depends on, so I’ve tried hard not to break anything. Here’s how.</p>
			</div>
			<dl class="rules">
				{
					safety.map((s) => (
						<div>
							<dt class="caps">{s.rule}</dt>
							<dd set:html={s.text} />
						</div>
					))
				}
			</dl>
			<aside class="btw" aria-labelledby="btw-vibes">
				<p id="btw-vibes" class="btw-title caps">Yes, it’s vibe-coded</p>
				<p>
					But at least it’s vibe-coded by a professional software engineer with lots of experience. 🤷🏻‍♂️ If something does go wrong, your
					backups are in <code>hermaeus-backups</code>, and I’d like to <a href={issues}>hear&nbsp;about&nbsp;it</a>.
				</p>
			</aside>
		</section>

		<section class="block" id="download" aria-labelledby="download-title">
			<div class="intro">
				<h2 id="download-title" class="caps">Download</h2>
				<p>One executable for each system. On Windows:</p>
				<ul class="steps">
					<li><strong>MO2 users:</strong> put <code>Hermaeus.exe</code> in your MO2 installation folder (the same folder as <code>ModOrganizer.exe</code>).</li>
					<li>
						<strong>Everyone else (including Vortex users):</strong> put <code>Hermaeus.exe</code> in your Skyrim installation folder (the same
						folder as <code>Skyrim.exe</code> or <code>SkyrimVR.exe</code>).
					</li>
				</ul>
				<p>
					Then run it! It opens in your browser and finds SkyrimNet’s data automatically. If it can’t, it asks. There are fancy command-line switches listed in <a href={`${repository}#running-it`}>the README</a>.
				</p>
				<p>
					Close Skyrim before you save anything. Hermaeus will tell you if you haven’t.
				</p>
			</div>
			<ul class="systems">
				{
					downloads.map((d) => (
						<li data-os={d.os}>
							<span class="os caps">
								<Diamond />
								{d.label}
							</span>
							<span class="note">{d.note}</span>
							<a class="button" href={d.href} data-os={d.os}>
								Download<span class="visually-hidden"> for {d.label}</span>
							</a>
						</li>
					))
				}
			</ul>
			<p class="after">
				Every release is on <a href={releases}>GitHub</a>, listing what changed.
			</p>
		</section>
	</main>

	<footer class="foot">
		<Mark size="2.5rem" />
		<div class="legal">
			<p class="who">
				Made by Davey, a software engineer for somewhere in the neighborhood of a quarter-century, who plays way too much Skyrim VR and
				spends <em>even more</em> time fiddling with it.
			</p>
			<p>
				Hermaeus works with SkyrimNet but isn’t part of it, and isn’t affiliated with or endorsed by Fateless.Ai. It includes none of SkyrimNet’s files.
			</p>
			<p>
				The Elder Scrolls V: Skyrim is a trademark of ZeniMax Media Inc.
			</p>
			<p>Released under the <a href={license}>MIT License</a>. Copyright © 2026 Davey Strus.</p>
		</div>
		<nav class="links caps" aria-label="Elsewhere">
			<a href={repository}>Source</a>
			<a href={releases}>Releases</a>
			<a href={issues}>Issues</a>
		</nav>
	</footer>

	<div class="strip">
		<button type="button" class="tip" data-tips={JSON.stringify(tips)} aria-live="polite">
			<span data-tip>{tips[0]}</span><span class="visually-hidden"> (Another tip)</span>
		</button>
		<nav class="hints caps" aria-label="Keyboard shortcuts">
			<button type="button" data-key="d"><kbd>D</kbd>Download</button>
			<button type="button" data-key="s"><kbd>S</kbd>Safety</button>
			<button type="button" data-key="n"><kbd>N</kbd>Next</button>
		</nav>
	</div>
</Base>

<script>
	// The theme switch: Auto follows the OS; Dark and Light are remembered.
	const root = document.documentElement;
	const choices = document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]');
	function showTheme() {
		const current = root.dataset.theme ?? 'system';
		choices.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.themeChoice === current)));
	}
	choices.forEach((b) =>
		b.addEventListener('click', () => {
			const t = b.dataset.themeChoice;
			if (t === 'dark' || t === 'light') root.dataset.theme = t;
			else delete root.dataset.theme;
			try {
				if (t === 'dark' || t === 'light') localStorage.setItem('hermaeus-theme', t);
				else localStorage.removeItem('hermaeus-theme');
			} catch {}
			showTheme();
		})
	);
	showTheme();

	// The visitor's own system leads the downloads.
	const platform = ((navigator as any).userAgentData?.platform ?? navigator.platform ?? '').toLowerCase();
	const os = platform.startsWith('mac') ? 'macos' : platform.includes('linux') ? 'linux' : platform.startsWith('win') ? 'windows' : '';
	const list = document.querySelector('[data-downloads]');
	const mine = os && list?.querySelector<HTMLElement>(`[data-os="${os}"]`);
	if (list && mine && mine !== list.firstElementChild) {
		list.querySelector('.primary')?.classList.remove('primary');
		mine.classList.add('primary');
		list.prepend(mine);
	}
	const row = os && document.querySelector<HTMLElement>(`.systems [data-os="${os}"]`);
	if (row) {
		row.classList.add('mine');
		row.querySelector('.button')?.classList.add('primary');
		row.parentElement?.prepend(row);
	}

	// The screen nearest the middle of the window is lit; the rest dim.
	const shots = document.querySelector('[data-shots]');
	if (shots && 'IntersectionObserver' in window) {
		const items = [...shots.children];
		const io = new IntersectionObserver(
			(entries) => {
				for (const e of entries) if (e.isIntersecting) items.forEach((li) => li.classList.toggle('lit', li === e.target));
			},
			{ rootMargin: '-45% 0px -45% 0px' }
		);
		items.forEach((li) => io.observe(li));
		shots.classList.add('dimming');
	}

	// The hint strip: every hint is a real shortcut, and clicking it does the same.
	const order = ['why', 'screens', 'rest', 'safety', 'download'];
	// The next section is the first whose top is still below where scrolling
	// to a section leaves it (the page's scroll padding), so the one just
	// reached doesn't count. After the last, back to the top.
	function next() {
		const landed = parseFloat(getComputedStyle(root).scrollPaddingTop) || 0;
		const id = order.find((id) => (document.getElementById(id)?.getBoundingClientRect().top ?? 0) > landed + 1);
		go(id ?? 'top');
	}
	function go(id: string) {
		document.getElementById(id)?.scrollIntoView();
		if (id === 'download') document.querySelector<HTMLElement>('#download .button')?.focus({ preventScroll: true });
	}
	const actions: Record<string, () => void> = { d: () => go('download'), s: () => go('safety'), n: next };
	// The key cap presses in, as the game's do, whichever way the hint ran.
	function press(key: string) {
		const b = document.querySelector<HTMLElement>(`.hints [data-key="${key}"]`);
		if (!b) return;
		b.classList.remove('pressed');
		void b.offsetWidth;
		b.classList.add('pressed');
	}
	document.querySelectorAll<HTMLButtonElement>('.hints [data-key]').forEach((b) =>
		b.addEventListener('click', () => {
			press(b.dataset.key!);
			actions[b.dataset.key!]();
		})
	);
	document.addEventListener('keydown', (e) => {
		if (e.metaKey || e.ctrlKey || e.altKey || e.defaultPrevented) return;
		const t = e.target as HTMLElement;
		if (t.isContentEditable || /^(INPUT|TEXTAREA|SELECT)$/.test(t.tagName)) return;
		const key = e.key.toLowerCase();
		const run = actions[key];
		if (run) {
			e.preventDefault();
			press(key);
			run();
		}
	});

	// A tip at random per visit; a click shows the next, never the same one twice running.
	const tip = document.querySelector<HTMLButtonElement>('.tip');
	const tipText = tip?.querySelector<HTMLElement>('[data-tip]');
	if (tip && tipText) {
		const all: string[] = JSON.parse(tip.dataset.tips ?? '[]');
		let at = Math.floor(Math.random() * all.length);
		tipText.textContent = all[at];
		tip.addEventListener('click', () => {
			at = (at + 1 + Math.floor(Math.random() * (all.length - 1))) % all.length;
			tipText.textContent = all[at];
			tip.classList.remove('fresh');
			void tip.offsetWidth;
			tip.classList.add('fresh');
		});
	}
</script>

<style>
	.skip {
		position: absolute;
		left: var(--gutter);
		top: -4rem;
		padding: var(--space-2) var(--space-3);
		background: var(--accent);
		color: var(--on-accent);
		z-index: 3;
	}
	.skip:focus {
		top: var(--space-2);
	}

	/* The top bar, as the app's: the name at left, the rest at right. */
	.top {
		display: flex;
		align-items: center;
		gap: var(--space-6);
		padding: var(--space-4) var(--gutter);
		border-bottom: 1px solid var(--rule);
	}
	.brand {
		display: inline-flex;
		align-items: center;
		gap: var(--space-3);
		font-size: var(--step-2);
		font-weight: 600;
		text-decoration: none;
	}
	.sections {
		display: flex;
		gap: var(--space-6);
		margin-left: auto;
		font-size: var(--step-1);
	}
	.sections a {
		color: var(--muted);
		text-decoration: none;
	}
	.sections a:hover {
		color: var(--ink);
	}
	.theme {
		display: flex;
		border: 1px solid var(--rule-strong);
		border-radius: var(--radius);
		overflow: hidden;
	}
	.theme button {
		font: 500 var(--step--1) / 1 var(--font-label);
		letter-spacing: var(--track);
		text-transform: uppercase;
		color: var(--muted);
		background: none;
		border: 0;
		padding: var(--space-2) var(--space-3);
		cursor: pointer;
	}
	.theme button:hover {
		color: var(--ink);
	}
	.theme button[aria-pressed='true'] {
		background: var(--accent);
		color: var(--on-accent);
		font-weight: 600;
	}

	/* The first viewport: the entry leads, the offer stands beside it. */
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(19rem, 26rem);
		grid-template-areas: 'entry offer' 'more more';
		grid-template-rows: 1fr auto;
		column-gap: clamp(var(--space-6), 6vw, 6rem);
		align-items: center;
		min-height: calc(100svh - 4.5rem - 2.75rem);
		padding: var(--space-8) var(--gutter) var(--space-5);
	}
	@media (min-width: 80rem) {
		.hero {
			grid-template-columns: minmax(0, 1fr) 28rem;
		}
